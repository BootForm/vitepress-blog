# Build output and dependencies.
node_modules
docs/.vitepress/dist
docs/.vitepress/cache

# The feed is generated by `npm run gen-rss` on every build; formatting it would only fight the
# next build.
docs/public/feed.xml

# Markdown is left alone on purpose. The posts and the page templates carry Vue templates inside
# markdown, and `AGENTS.md` documents a nested `v-for` that only works while it stays written as
# flat, single-line HTML. A formatter that rewraps that markup brings the bug back with no error
# to point at.
*.md
