{
  "name": "vitepress-blog",
  "description": "Vitepress blog template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "prebuild": "npm run gen-rss",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "gen-rss": "node scripts/generate-rss.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"**/*.{ts,js,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.48.1",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{ts,vue,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
